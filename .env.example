# Copia este archivo a ".env" y completa los valores para desarrollo local.
# En CI/CD estas variables se configuran como GitHub Secrets (ver ci.yml),
# no se sube un .env real.

# --- Ambiente: main | qa | dev (define el sufijo de la base de datos Mongo) ---
ENVIRONMENT=dev

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
# Opcional: nombre base de la DB (por defecto "rag-duoc-groq").
# MONGO_DB_BASE=rag-duoc-groq

# --- Groq (LLM) ---
GROQ_API_KEY=
# El modelo DEBE soportar function calling. Los sistemas "compound" de Groq no
# aceptan herramientas propias y no sirven para el agente.
GROQ_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024

# --- Embeddings locales (sentence-transformers) ---
# Si cambias de modelo, ajusta EMBEDDING_DIM para que calce con el índice Atlas.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Fuente de ingesta: repo GitHub o carpeta local ./data con los .md del ramo ---
GITHUB_REPO=https://github.com/tu-usuario/tu-repo
# Opcional, para evitar rate-limits al listar/descargar del repo.
GITHUB_TOKEN=

# --- Retrieval / chunking (opcionales) ---
# TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# --- Costos: override opcional de tarifas Groq (USD por 1M tokens) ---
# GROQ_PRICE_IN=0.29
# GROQ_PRICE_OUT=0.59

# --- Agente ---
# Identificador del estudiante (los documentos de tareas/asistencia lo guardan).
USUARIO_ID=estudiante
# Minimo de asistencia exigido, en %.
ASISTENCIA_MINIMA=70
# Tope de vueltas del ciclo del agente.
MAX_PASOS_AGENTE=5
